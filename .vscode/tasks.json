{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar KeyMix Pro",
      "type": "shell",
      "command": "python3 -u -m http.server 8080",
      "windows": { "command": "py -u -m http.server 8080" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "keymix",
        "pattern": { "regexp": "^__nunca__$" },
        "background": { "activesBegin": true, "beginsPattern": "Serving HTTP", "endsPattern": "Serving HTTP" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
